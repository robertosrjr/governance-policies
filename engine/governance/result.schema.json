{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance.local/schemas/result-1.3.json",
  "title": "Resultado da avaliação de governança (evidência atestada por commit)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "summary", "subject", "classification", "bundle", "policies_evaluated",
               "adr_compliance", "violations", "waived", "errors", "warnings", "stats"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "status": {"enum": ["APPROVED", "BLOCKED"]},
    "summary": {"type": "string"},
    "subject": {
      "type": "object",
      "required": ["repository", "commit", "base"],
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": ["string", "null"]},
        "base": {"type": "string"},
        "pull_request": {"type": ["integer", "null"]}
      }
    },
    "classification": {
      "description": "1.3: classe do repositório (ADR-GOV-009); null fora do pipeline (eval, testes)",
      "type": ["object", "null"],
      "required": ["name", "source", "llm", "raised"],
      "properties": {
        "name": {"type": "string"},
        "source": {"enum": ["listed", "default"]},
        "llm": {"type": "boolean"},
        "raised": {"type": "object", "additionalProperties": {"enum": ["warn", "enforce"]}}
      }
    },
    "bundle": {
      "type": "object",
      "required": ["engine_version", "bundle_version", "governance_ref", "policies_digest", "llm"],
      "properties": {
        "engine_version": {"type": "string"},
        "bundle_version": {"type": "string"},
        "governance_ref": {"type": ["string", "null"]},
        "policies_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "llm": {
          "type": ["object", "null"],
          "required": ["provider", "model"],
          "properties": {"provider": {"type": "string"}, "model": {"type": "string"}}
        },
        "jev": {
          "description": "1.2: modelo de julgamento tipado (ADR-GOV-002); null se não usado",
          "type": ["object", "null"],
          "required": ["provider", "model"],
          "properties": {"provider": {"type": "string"}, "model": {"type": "string"}}
        }
      }
    },
    "policies_evaluated": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "mode"],
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "string"},
          "mode": {"enum": ["enforce", "warn", "audit"]}
        }
      }
    },
    "adr_compliance": {
      "type": "object",
      "additionalProperties": {"enum": ["PASS", "WARN", "FAIL"]}
    },
    "violations": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "waived": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "stats": {"type": "object"}
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "action"],
      "properties": {
        "kind": {"enum": ["llm_unavailable", "llm_not_configured", "llm_failure",
                          "input_too_large", "secret_scan"]},
        "message": {"type": "string"},
        "action": {"type": "string"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "severity", "file", "line", "message", "source", "blocking",
                   "waiver_id", "mode"],
      "properties": {
        "policy_id": {"type": "string"},
        "severity": {"enum": ["CRITICAL", "MAJOR", "MINOR"]},
        "file": {"type": "string"},
        "line": {"type": ["integer", "null"]},
        "message": {"type": "string"},
        "source": {"enum": ["deterministic", "llm"]},
        "blocking": {"type": "boolean"},
        "waiver_id": {"type": ["string", "null"]},
        "mode": {"enum": ["enforce", "warn", "audit"]}
      }
    }
  }
}
