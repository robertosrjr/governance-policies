{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governance.local/schemas/waiver-1.0.json",
  "title": "Waiver: exceção aprovada a uma política",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "policy_id", "repository", "paths", "justification", "requested_by",
               "approved_by", "created", "expires"],
  "properties": {
    "id": {"type": "string", "pattern": "^WVR-\\d{4}-\\d{3}$"},
    "policy_id": {"type": "string"},
    "repository": {"type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$"},
    "paths": {"type": "array", "minItems": 1, "items": {"type": "string", "not": {"const": "**"}}},
    "justification": {"type": "string", "minLength": 30},
    "requested_by": {"type": "string"},
    "approved_by": {"type": "string"},
    "created": {"type": "string", "format": "date"},
    "expires": {"type": "string", "format": "date"},
    "commit": {
      "description": "Opcional: restringe o waiver a um commit (prefixo do SHA)",
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    }
  }
}
